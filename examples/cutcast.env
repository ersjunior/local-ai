# examples/cutcast.env
# Exemplo de como o CutCast aponta para o gateway local-ai.
# Troque HOST e a key pela virtual key gerada.
#
# Sobre HOST:
#   - Windows nativo (Docker Desktop):     HOST = localhost
#   - WSL2 (Docker Desktop compartilhado): HOST = localhost também
#   - Linux (mesma máquina):               HOST = localhost
#   - Acessar de OUTRA máquina na rede:    HOST = IP do host que roda o Docker
#   - Consumidor DENTRO do Docker (rede localai_net): use http://gateway:4000/v1

LOCAL_CHAT_BASE_URL=http://HOST:4000/v1
LOCAL_CHAT_MODEL=chat-cuts
LOCAL_VISION_MODEL=vision-default
LOCAL_TRANSCRIBE_MODEL=whisper
LOCAL_IMAGE_MODEL=image-thumbs

# Virtual key criada via: curl POST http://HOST:4000/key/generate ...
# Use metadata.app_id na key para o Model Registry (tenant cutcast).
LOCAL_AI_API_KEY=sk-cutcast-virtualkey-change-me

# Model Registry (modelos dinâmicos — opcional, aba "Novos modelos" no futuro)
# LOCAL_REGISTRY_URL=http://HOST:4010/registry/v1

# Fallback (se o gateway não proxyar áudio/imagem nesta versão do LiteLLM):
# LOCAL_TRANSCRIBE_BASE_URL=http://HOST:18001/v1
# LOCAL_IMAGE_BASE_URL=http://HOST:18002/v1
