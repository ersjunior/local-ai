# ==========================================================================
# local-ai — variáveis de ambiente (copie para .env e ajuste)
#   cp .env.example .env
# ==========================================================================

# --- Gateway (LiteLLM) ---
LITELLM_MASTER_KEY=sk-master-change-me
LITELLM_SALT_KEY=salt-change-me
GATEWAY_PORT=4000
# Opcional: Postgres para persistir virtual keys e logs de uso.
# Sem isto, as keys ficam em memória (perdidas ao reiniciar o gateway).
# DATABASE_URL=postgresql://user:pass@host:5432/litellm

# --- Modelos padrão ---
WHISPER_MODEL=large-v3

# --- HuggingFace token (imagem/vLLM) ---
# Necessário para baixar o FLUX.1-schnell (repo GATED) — modelo de imagem PADRÃO.
# Aceite os termos em https://huggingface.co/black-forest-labs/FLUX.1-schnell e
# cole o token aqui. Licença dos pesos: Apache-2.0. (Também usado pelo vLLM.)
HUGGING_FACE_HUB_TOKEN=

# --- Portas dos backends (host) ---
# (já definidas nos compose; ajuste apenas se colidirem com outros serviços)
OLLAMA_PORT=11434
WHISPER_PORT=18001
IMAGES_PORT=18002
VLLM_PORT=18000

# --- Ollama (orçamento de VRAM em single-GPU) ---
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1

# --- vLLM (perfil perf, opcional) ---
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MAX_MODEL_LEN=8192
# (token HF definido acima em HUGGING_FACE_HUB_TOKEN)
