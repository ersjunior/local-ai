# ==========================================================================
# local-ai — variáveis de ambiente (copie para .env e ajuste)
#   cp .env.example .env
# ==========================================================================

# --- Gateway (LiteLLM) ---
LITELLM_MASTER_KEY=sk-master-change-me
LITELLM_SALT_KEY=salt-change-me
GATEWAY_PORT=4000
# --- PostgreSQL (servidor compartilhado do stack) ---
# Superusuário do servidor (administra todos os databases das apps).
POSTGRES_USER=localai
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Database dedicado do gateway (LiteLLM). O init cria role+db idempotentemente.
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=troque-por-senha-forte
LITELLM_DB_NAME=litellm
# String de conexão que o gateway usa. IMPORTANTE:
#   - host = 'postgres' (nome do serviço na rede interna), porta interna 5432
#   - deve BATER com LITELLM_DB_USER / LITELLM_DB_PASSWORD / LITELLM_DB_NAME acima
DATABASE_URL=postgresql://litellm:troque-por-senha-forte@postgres:5432/litellm

# --- Modelos padrão ---
WHISPER_MODEL=large-v3
# API key do whisper (hwdsl2/whisper-server). Quando definida, o server EXIGE
# "Authorization: Bearer <key>" e o gateway envia a mesma automaticamente.
# Deixe VAZIO (WHISPER_API_KEY=) para desabilitar a autenticação.
# Obs.: se você já subiu o whisper antes, ele auto-gerou uma key no volume;
# definir aqui um valor conhecido sobrescreve na próxima recriação do container.
WHISPER_API_KEY=whisper-change-me

# --- HuggingFace token (imagem/vLLM) ---
# Necessário para baixar o FLUX.1-schnell (repo GATED) — modelo de imagem PADRÃO.
# Aceite os termos em https://huggingface.co/black-forest-labs/FLUX.1-schnell e
# cole o token aqui. Licença dos pesos: Apache-2.0. (Também usado pelo vLLM.)
HUGGING_FACE_HUB_TOKEN=

# --- Portas dos backends (host) ---
# (já definidas nos compose; ajuste apenas se colidirem com outros serviços)
OLLAMA_PORT=11434
WHISPER_PORT=18001
IMAGES_PORT=18002
VLLM_PORT=18000

# --- Ollama (orçamento de VRAM em single-GPU) ---
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1

# --- vLLM (perfil perf, opcional) ---
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MAX_MODEL_LEN=8192
# (token HF definido acima em HUGGING_FACE_HUB_TOKEN)
